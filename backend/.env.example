# CMEP Campus Digital - variables del backend (API y worker) en desarrollo local.
# Copia este archivo a backend/.env (backend/.env no se versiona).
# Estos valores NO son secretos y NO deben usarse en prod.
#
# Usa 127.0.0.1 y no localhost: en Windows localhost puede resolver primero a ::1.

NODE_ENV=development
# Dentro de Docker, HOST debe ser 0.0.0.0 para aceptar conexiones del proxy;
# en tu maquina se queda en 127.0.0.1.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# DATABASE_URL DEBE COINCIDIR con la de infra/.env (usuario, contrasena, base y
# POSTGRES_PORT, 5433 por defecto). Si cambias una, cambia la otra: los dos
# .env.example se editan juntos. El CLI de Prisma lo lee a traves de backend/prisma.config.ts.
DATABASE_URL=postgresql://campus:dev_postgres_no_usar_en_prod@127.0.0.1:5433/campus_dev?schema=public
# Secreto con el que la API firma los tokens de acceso (JWT HS256). Minimo 32 caracteres.
# Este valor de ejemplo solo sirve en development y test: con NODE_ENV=production la API se niega
# a arrancar si JWT_SECRET es este literal o mide menos de 32 caracteres. Genera uno propio con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev_jwt_secret_de_desarrollo_no_valido_para_prod_0123456789
# Cuenta unica de administrador. Solo las usan npm run seed:admin (crea la cuenta; falla si ya
# existe) y npm run reset:admin (cambia su contrasena y cierra sus sesiones). En prod se definen en
# el .env del servidor solo para ejecutar el script y se retiran despues de usarlas.
# ADMIN_PASSWORD: entre 10 y 128 caracteres. ADMIN_NOMBRE: entre 2 y 120.
ADMIN_EMAIL=admin@campus.local
ADMIN_PASSWORD=cambia-esta-contrasena-dev
ADMIN_NOMBRE=Administración CMEP
