generator client {
  provider               = "prisma-client"
  output                 = "../src/adapters/db/generated"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  estudiante
  maestro
  admin

  @@map("rol_usuario")
}

enum EstadoPago {
  al_corriente
  deudor

  @@map("estado_pago")
}

enum TipoTokenCuenta {
  recuperacion
  invitacion

  @@map("tipo_token_cuenta")
}

enum OrigenInscripcion {
  codigo
  manual

  @@map("origen_inscripcion")
}

enum TipoMovimientoInscripcion {
  alta
  baja

  @@map("tipo_movimiento_inscripcion")
}

enum TipoPublicacion {
  anuncio
  material

  @@map("tipo_publicacion")
}

enum EstadoArchivo {
  pendiente
  confirmado
  descartado

  @@map("estado_archivo")
}

// Un solo rol = admin: índice único parcial creado a mano en la migración usuarios_y_sesiones
// (Prisma no expresa índices parciales; DEC-01). nombre_busqueda se normaliza en core/ (DEC-02).
model Usuario {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                 String                  @unique
  hashContrasena        String                  @map("hash_contrasena")
  debeCambiarContrasena Boolean                 @default(false) @map("debe_cambiar_contrasena")
  nombre                String
  nombreBusqueda        String                  @map("nombre_busqueda")
  rol                   Rol
  activo                Boolean                 @default(true)
  estadoPago            EstadoPago              @default(al_corriente) @map("estado_pago")
  fechaEstadoPago       DateTime?               @map("fecha_estado_pago") @db.Timestamptz(3)
  accesoRestringido     Boolean                 @default(false) @map("acceso_restringido")
  motivoRestriccion     String?                 @map("motivo_restriccion")
  fechaRestriccion      DateTime?               @map("fecha_restriccion") @db.Timestamptz(3)
  creadoEn              DateTime                @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn         DateTime                @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  enlaceRegistroId      String?                 @map("enlace_registro_id") @db.Uuid
  sesiones              Sesion[]
  tokensCuenta          TokenCuenta[]
  enlaceRegistro        EnlaceRegistro?         @relation(fields: [enlaceRegistroId], references: [id], onDelete: Restrict)
  clasesImpartidas      Clase[]                 @relation("ClasesDelMaestro")
  inscripciones         Inscripcion[]
  movimientosComoAlumno MovimientoInscripcion[] @relation("MovimientosDelAlumno")
  movimientosComoActor  MovimientoInscripcion[] @relation("MovimientosDelActor")
  asignacionesDeClase   MaestroDeClase[]        @relation("AsignacionesDelMaestro")
  publicaciones         Publicacion[]
  comentarios           Comentario[]
  archivosSubidos       Archivo[]

  @@index([rol])
  @@index([enlaceRegistroId, creadoEn])
  @@index([nombreBusqueda(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("usuarios")
}

// reemplazada_por es un uuid sin FK (S-11): apunta a la sesión que la sustituyó al rotar.
model Sesion {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId      String    @map("usuario_id") @db.Uuid
  hashToken      String    @unique @map("hash_token")
  expiraEn       DateTime  @map("expira_en") @db.Timestamptz(3)
  revocadaEn     DateTime? @map("revocada_en") @db.Timestamptz(3)
  reemplazadaPor String?   @map("reemplazada_por") @db.Uuid
  ip             String?
  agente         String?
  creadoEn       DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn  DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  usuario        Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sesiones")
}

// Enlaces de un solo uso (recuperación 30 min, invitación 72 h). Solo el SHA-256 del token; el
// token se deriva del id con una clave del servidor (DEC-03). revocado_en: invalidado por otro
// enlace más nuevo, por el admin o por una corrección de correo.
model TokenCuenta {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId     String          @map("usuario_id") @db.Uuid
  tipo          TipoTokenCuenta
  hashToken     String          @unique @map("hash_token")
  expiraEn      DateTime        @map("expira_en") @db.Timestamptz(3)
  usadoEn       DateTime?       @map("usado_en") @db.Timestamptz(3)
  revocadoEn    DateTime?       @map("revocado_en") @db.Timestamptz(3)
  creadoEn      DateTime        @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime        @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  usuario       Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  // AUTH-03c: cupo diario de invitaciones (ventana móvil de 24 h sobre tipo = 'invitacion', §D-C2).
  @@index([tipo, creadoEn])
  @@map("tokens_cuenta")
}

// AUTH-03b: enlace de registro de maestro. Solo el SHA-256 del token; el token aleatorio se
// muestra una sola vez, al crearlo, y nunca se guarda (§D-B3). El estado (vigente, vencido,
// revocado) se deriva en core/, no se guarda (§D-B1). Sin creado_por (S-09): la cuenta admin es
// única.
model EnlaceRegistro {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hashToken     String    @unique @map("hash_token")
  expiraEn      DateTime  @map("expira_en") @db.Timestamptz(3)
  revocadoEn    DateTime? @map("revocado_en") @db.Timestamptz(3)
  creadoEn      DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  registrados   Usuario[]

  @@index([creadoEn(sort: Desc), id(sort: Desc)])
  @@map("enlaces_registro")
}

// CLASES-a (§D-A1). codigoInvitacion: 7 caracteres de un alfabeto sin I, O, 0 ni 1 (S-03); único
// para poder buscarlo. activa se crea en true (S-05) pero ninguna ruta de CLASES la usa ni la
// cambia (RF-50 queda para más adelante).
// CLASES-02 (P-06 a): los maestros de la clase son maestros_de_clase (de uno a dos). maestro_id se
// conserva NOT NULL solo por compatibilidad hacia atrás: el código lo ESCRIBE (el primer maestro al
// crear la clase; el que queda al retirar al que estaba ahí) y NUNCA lo lee. Se retira en una
// migración posterior, junto con la relación maestro.
model Clase {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  maestroId        String                  @map("maestro_id") @db.Uuid
  nombre           String
  descripcion      String?
  codigoInvitacion String                  @unique @map("codigo_invitacion")
  activa           Boolean                 @default(true)
  creadoEn         DateTime                @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn    DateTime                @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  maestro          Usuario                 @relation("ClasesDelMaestro", fields: [maestroId], references: [id], onDelete: Restrict)
  inscripciones    Inscripcion[]
  movimientos      MovimientoInscripcion[]
  publicaciones    Publicacion[]
  archivos         Archivo[]
  maestros         MaestroDeClase[]

  @@index([maestroId, creadoEn(sort: Desc), id(sort: Desc)])
  @@index([creadoEn(sort: Desc), id(sort: Desc)])
  @@map("clases")
}

// PK compuesta (clase_id, usuario_id): un alumno se inscribe una sola vez por clase (§D-A1).
// origen distingue unirse con código de un alta manual (CLASES-b); movimientos_inscripcion
// (CLASES-b) registra las altas manuales y las bajas, no las inscripciones por código.
model Inscripcion {
  claseId   String            @map("clase_id") @db.Uuid
  usuarioId String            @map("usuario_id") @db.Uuid
  origen    OrigenInscripcion
  creadoEn  DateTime          @default(now()) @map("creado_en") @db.Timestamptz(3)
  clase     Clase             @relation(fields: [claseId], references: [id], onDelete: Cascade)
  usuario   Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([claseId, usuarioId])
  @@index([usuarioId, creadoEn(sort: Desc), claseId(sort: Desc)])
  @@map("inscripciones")
}

// CLASES-02 (§D-2A1). Los maestros de una clase: de uno a dos, el tope y el mínimo se validan en
// core/ dentro de la transacción que cambia la asignación (con la fila de la clase bloqueada). Solo
// la escribe el administrador. Orden de los maestros: (creado_en, maestro_id). Las asignaciones
// mueren con su clase (CASCADE); un usuario con asignaciones no se borra (RESTRICT).
model MaestroDeClase {
  claseId   String   @map("clase_id") @db.Uuid
  maestroId String   @map("maestro_id") @db.Uuid
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  clase     Clase    @relation(fields: [claseId], references: [id], onDelete: Cascade)
  maestro   Usuario  @relation("AsignacionesDelMaestro", fields: [maestroId], references: [id], onDelete: Restrict)

  @@id([claseId, maestroId])
  @@index([maestroId, creadoEn(sort: Desc), claseId(sort: Desc)])
  @@map("maestros_de_clase")
}

// CLASES-b (§D-B8). Registro de las altas manuales y las bajas (P-05 g, S-23): solo se escribe, en
// la misma transacción que el cambio, y ninguna ruta ni función de CLASES lo lee. El orden del
// registro es secuencia (toma su valor en el INSERT, que es el último paso de la transacción);
// creado_en es la hora de inicio de la transacción y no sirve para ordenar. Llaves foráneas con
// ON DELETE RESTRICT: un registro no desaparece en silencio con una cascada. Sin índices
// secundarios: ninguna consulta lo lee todavía (los propondrá la pantalla de ADMIN).
model MovimientoInscripcion {
  id        String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  secuencia BigInt                    @default(autoincrement())
  claseId   String                    @map("clase_id") @db.Uuid
  alumnoId  String                    @map("alumno_id") @db.Uuid
  actorId   String                    @map("maestro_id") @db.Uuid
  tipo      TipoMovimientoInscripcion
  creadoEn  DateTime                  @default(now()) @map("creado_en") @db.Timestamptz(3)
  clase     Clase                     @relation(fields: [claseId], references: [id], onDelete: Restrict)
  alumno    Usuario                   @relation("MovimientosDelAlumno", fields: [alumnoId], references: [id], onDelete: Restrict)
  actor     Usuario                   @relation("MovimientosDelActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@map("movimientos_inscripcion")
}

// CLASES-c (§D-C1). El muro: anuncios y materiales de una clase. El CHECK publicaciones_titulo_segun_tipo
// (el anuncio no lleva título y el material sí) se agregó a mano en la migración: Prisma no expresa
// CHECK ni lo compara al buscar deriva. Las llaves foráneas de autoría son ON DELETE RESTRICT (no
// hay bajas físicas de usuarios); las de clase y publicación, CASCADE.
model Publicacion {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  claseId       String          @map("clase_id") @db.Uuid
  autorId       String          @map("autor_id") @db.Uuid
  tipo          TipoPublicacion
  titulo        String?
  texto         String
  creadoEn      DateTime        @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime        @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  clase         Clase           @relation(fields: [claseId], references: [id], onDelete: Cascade)
  autor         Usuario         @relation(fields: [autorId], references: [id], onDelete: Restrict)
  comentarios   Comentario[]
  archivos      Archivo[]

  @@index([claseId, creadoEn(sort: Desc), id(sort: Desc)])
  @@map("publicaciones")
}

model Comentario {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicacionId String      @map("publicacion_id") @db.Uuid
  autorId       String      @map("autor_id") @db.Uuid
  texto         String
  creadoEn      DateTime    @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime    @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  publicacion   Publicacion @relation(fields: [publicacionId], references: [id], onDelete: Cascade)
  autor         Usuario     @relation(fields: [autorId], references: [id], onDelete: Restrict)

  @@index([publicacionId, creadoEn, id])
  @@map("comentarios")
}

// CLASES-d (§D-D1). Metadatos de un archivo del almacén; el objeto vive en R2 o MinIO, nunca en la
// base. clave_objeto es materiales/{claseId}/{archivoId}: el nombre del usuario no forma parte de
// ella. Los dos CHECK (tamano > 0, y confirmado si y solo si tiene publicación) se agregaron a mano
// en la migración: Prisma no expresa CHECK ni lo compara al buscar deriva. publicacion_id es
// ON DELETE NO ACTION: al borrar una clase, la cascada borra en la misma sentencia sus publicaciones
// y sus archivos, y la comprobación se hace al final de la sentencia.
model Archivo {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  claveObjeto   String        @unique @map("clave_objeto")
  nombre        String
  tipo          String
  tamano        Int
  subidoPor     String        @map("subido_por") @db.Uuid
  estado        EstadoArchivo @default(pendiente)
  claseId       String        @map("clase_id") @db.Uuid
  publicacionId String?       @map("publicacion_id") @db.Uuid
  creadoEn      DateTime      @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime      @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  autor         Usuario       @relation(fields: [subidoPor], references: [id], onDelete: Restrict)
  clase         Clase         @relation(fields: [claseId], references: [id], onDelete: Cascade)
  publicacion   Publicacion?  @relation(fields: [publicacionId], references: [id], onDelete: NoAction)

  @@index([publicacionId])
  @@map("archivos")
}
