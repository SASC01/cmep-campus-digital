# CMEP Campus Digital - variables del entorno de desarrollo local.
# Copia este archivo a infra/.env (infra/.env no se versiona).
# Estos valores NO son secretos y NO deben usarse en prod.
#
# Usa 127.0.0.1 y no localhost: los puertos se publican solo en IPv4 y en
# Windows localhost puede resolver primero a ::1.

# --- PostgreSQL ---
# Las credenciales se graban al crear el volumen: cambiarlas despues no tiene
# efecto sobre un volumen que ya existe.
# Se usa el puerto 5433 y no el 5432 para no chocar con un PostgreSQL instalado
# directamente en Windows, que ocupa el 5432.
POSTGRES_USER=campus
POSTGRES_PASSWORD=dev_postgres_no_usar_en_prod
POSTGRES_DB=campus_dev
POSTGRES_PORT=5433
# DATABASE_URL debe coincidir con POSTGRES_USER, POSTGRES_PASSWORD,
# POSTGRES_PORT y POSTGRES_DB.
DATABASE_URL=postgresql://campus:dev_postgres_no_usar_en_prod@127.0.0.1:5433/campus_dev?schema=public

# --- Almacen de archivos (MinIO en dev, protocolo S3) ---
# STORAGE_ENDPOINT debe coincidir con MINIO_API_PORT.
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_ACCESS_KEY=campusdev
STORAGE_SECRET_KEY=dev_minio_no_usar_en_prod
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- LiveKit (servidor local en modo --dev) ---
# devkey / secret las fija el modo --dev de LiveKit: cambiarlas aqui no cambia
# el servidor. Para probar grabaciones se sustituyen, solo en tu .env local,
# por las llaves de un proyecto de LiveKit Cloud de desarrollo.
# Los puertos de LiveKit (7880, 7881 y 7882/udp) son fijos.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
