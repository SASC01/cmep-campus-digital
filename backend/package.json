{
  "name": "@campus/backend",
  "version": "0.0.0",
  "private": true,
  "description": "API y worker de CMEP Campus Digital",
  "type": "module",
  "scripts": {
    "shared:build": "npm --prefix ../shared run build",
    "predev": "npm run shared:build && prisma generate",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "predev:worker": "npm run shared:build && prisma generate",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "prebuild": "npm run shared:build && prisma generate",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prelint": "npm run shared:build && prisma generate",
    "lint": "eslint --config ../eslint.config.mjs . && prettier --check . --ignore-path ../.prettierignore && npm run typecheck",
    "format": "prettier --write . --ignore-path ../.prettierignore",
    "pretest": "npm run shared:build && prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:admin": "tsx --env-file-if-exists=.env src/scripts/seed-admin.ts",
    "reset:admin": "tsx --env-file-if-exists=.env src/scripts/reset-admin.ts"
  },
  "dependencies": {
    "@campus/shared": "*",
    "@fastify/cookie": "^11.1.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.1.0",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "vitest": "^4.1.11"
  }
}
